<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>delivery_bot_planner</name>
  <version>0.1.0</version>
  <description>Hybrid-A* path planner for an Ackermann robot (PlanPath action), plus path smoothing, resampling, curvature validation and step segmentation.</description>
  <maintainer email="leonstiffel@gmail.com">Leon Stiffel</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>delivery_bot_geometry</depend>
  <depend>delivery_bot_collision</depend>
  <depend>delivery_bot_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
