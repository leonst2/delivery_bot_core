# ROS 2 C++ style (the ament_clang_format configuration) with 120 columns, like the Python code.
Language: Cpp
BasedOnStyle: Google

AccessModifierOffset: -2
AlignAfterOpenBracket: AlwaysBreak
BraceWrapping:
  AfterClass: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
BreakBeforeBraces: Custom
ColumnLimit: 120
ConstructorInitializerIndentWidth: 0
ContinuationIndentWidth: 2
DerivePointerAlignment: false
IncludeBlocks: Preserve  # keep standard and ROS headers in separate blocks
PackConstructorInitializers: Never
PointerAlignment: Middle
ReflowComments: false
SpaceAfterTemplateKeyword: false
