<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>delivery_bot_tracker</name>
  <version>0.1.0</version>
  <description>Dynamic obstacle detection and tracking with prediction (/tracked_obstacles).</description>
  <maintainer email="leonstiffel@gmail.com">Leon Stiffel</maintainer>
  <license>Proprietary</license>

  <depend>rclrs</depend>
  <depend>builtin_interfaces</depend>
  <depend>delivery_bot_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_msgs</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
