<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>delivery_bot_navigation</name>
  <version>0.1.0</version>
  <description>Nav2 parameters and bringup for the delivery_bot. Used unchanged by the simulation and the physical robot.</description>
  <maintainer email="leonstiffel@gmail.com">Leon Stiffel</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>delivery_bot</exec_depend>
  <exec_depend>delivery_bot_grid_step</exec_depend>
  <exec_depend>delivery_bot_perception</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
